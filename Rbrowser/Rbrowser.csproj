<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <TargetFramework>net10.0-android</TargetFramework><UseMaui>true</UseMaui><SingleProject>true</SingleProject>
  <OutputType>Exe</OutputType><RootNamespace>Rbrowser</RootNamespace><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
  <ApplicationTitle>Rbrowser</ApplicationTitle><ApplicationId>dev.rbrowser.tv</ApplicationId><ApplicationDisplayVersion>0.8.2</ApplicationDisplayVersion><ApplicationVersion>11</ApplicationVersion>
  <DefineConstants Condition="'$(TvDiagnostics)'=='true'">$(DefineConstants);TV_DIAGNOSTICS</DefineConstants>
  <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion><AndroidPackageFormats>apk</AndroidPackageFormats>
  <RuntimeIdentifiers>android-arm64;android-arm</RuntimeIdentifiers><MauiVersion>10.0.110</MauiVersion>
 </PropertyGroup>
 <ItemGroup><PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" /><PackageReference Include="Xamarin.AndroidX.WebKit" Version="1.15.0" /><PackageReference Include="Xamarin.AndroidX.Media3.ExoPlayer.Hls" Version="1.11.1" /><PackageReference Include="Xamarin.AndroidX.Media3.ExoPlayer.Dash" Version="1.11.1" /><PackageReference Include="Xamarin.AndroidX.Media3.Ui" Version="1.11.1" /><ProjectReference Include="../Rbrowser.Core/Rbrowser.Core.csproj" /><MauiAsset Include="Resources/Raw/**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" /><MauiAsset Include="../THIRD_PARTY/**" LogicalName="licenses/%(RecursiveDir)%(Filename)%(Extension)" /></ItemGroup>
 <ItemGroup>
  <MauiAsset Include="../LICENSE" LogicalName="licenses/Rbrowser-MIT.txt" />
  <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.11.0.1" />
  <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" Version="2.11.0.1" />
  <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx" Version="2.11.0.1" />
  <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModelSavedState" Version="2.11.0.1" />
  <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModel.Ktx" Version="2.11.0.1" />
  <PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" Version="2.11.0.1" />
  <PackageReference Include="Xamarin.AndroidX.Collection.Ktx" Version="1.6.0.1" />
  <PackageReference Include="Xamarin.AndroidX.SavedState.SavedState.Ktx" Version="1.5.0.1" />
 </ItemGroup>
</Project>

